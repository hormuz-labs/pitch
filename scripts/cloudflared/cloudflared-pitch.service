[Unit]
Description=Cloudflare Tunnel — pitch (trypitch.co)
Documentation=https://github.com/hormuz-labs/pitch
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# TUNNEL_TOKEN is read from the project .env so there is a single source of truth.
# Adjust this path if you move the repository.
EnvironmentFile=/workspace/.env

# Token mode: TUNNEL_TOKEN makes cloudflared run the remotely-managed tunnel whose
# public hostnames are configured in the Cloudflare dashboard (Networks → Tunnels).
# NOTE: no --config flag is passed on purpose, so this connector does NOT load
# /etc/cloudflared/config.yml (that file belongs to the separate obybuy.com tunnel).
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run

Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
