generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

plugin prisma {
  provider = "@core/prisma"
  output = "./schema.prisma"
}

plugin enhancer {
  provider = "@core/enhancer"
}

// Dummy user model for ZenStack auth type-checking
// We use Clerk for auth, so this doesn't need to be in the database
model User {
  id    String @id

  @@auth()
  @@ignore()
}

// Stores Clerk user details synced on sign-in
model UserProfile {
  id        String   @id           // Clerk user ID
  email     String
  firstName String?
  lastName  String?
  imageUrl  String?
  // Discord's snowflake user id, mirrored from Clerk for indexed bot lookup.
  discordUserId String? @unique
  role      String   @default("user") // "user" or "admin"
  // Public handle, chosen in settings. Null until the user picks one, and
  // unique across accounts once they do.
  username  String?  @unique
  // Notification preferences. Email is on by default because it carries the
  // "your video is ready" mail; browser alerts need a permission prompt first.
  emailNotifications   Boolean @default(true)
  browserNotifications Boolean @default(false)
  gptEnabled Boolean @default(false) // Granted per user by an admin
  // Set when the user dismisses the welcome survey. The survey is never a
  // gate, so this only stops us asking again on their other devices.
  onboardingSkippedAt DateTime?
  // One-time product announcement dismissal, stored per account/device-independent.
  discordPromoSeenAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions      Subscription[]
  topUpPurchases     TopUpPurchase[]
  creditTransactions CreditTransaction[]
  affiliate          Affiliate?
  browserProfile     BrowserProfile?
  browserSessions    BrowserSession[]
  apiKeys            ApiKey[]
  webhookEndpoints   WebhookEndpoint[]
  webhookDeliveries  WebhookDelivery[]
  onboardingSurvey   OnboardingSurvey?
  promoRedemptions   PromoCodeRedemption[]
}

// Permanent campaign receipt: independent of the current Discord link and user
// lifecycle so unlinking or deleting an account cannot reset Discord eligibility.
// IDs are audit references, deliberately not cascading foreign keys.
model DiscordRewardClaim {
  id                  String   @id @default(cuid())
  campaignId          String
  userId              String
  discordUserId       String
  guildId             String
  credits             Int
  creditTransactionId String   @unique
  claimedAt           DateTime @default(now())

  @@unique([campaignId, userId])
  @@unique([campaignId, discordUserId])
  @@index([claimedAt])
  @@deny('all', true)
}

// A redeemable credit code. Minted by an admin, entered by a user in settings.
model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique   // stored upper-case, e.g. "LAUNCH50"
  credits         Int
  maxRedemptions  Int?                // null = unlimited
  redemptionCount Int       @default(0)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  redemptions PromoCodeRedemption[]

  // Codes are handed out, not browsed: only the server touches this table.
  @@deny('all', true)
}

// One redemption per account per code — the unique pair IS the once-only rule,
// so two simultaneous requests cannot both grant credits.
model PromoCodeRedemption {
  id        String   @id @default(cuid())
  userId    String
  codeId    String
  credits   Int                       // what was granted, for the activity list
  createdAt DateTime @default(now())

  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode   PromoCode   @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@unique([userId, codeId])
  @@index([codeId])
  @@deny('all', auth() == null)
  @@allow('read', userId == auth().id)
}

// One immutable onboarding response per Clerk user. The unique userId is the
// server-side guarantee that the survey can only be completed once.
model OnboardingSurvey {
  id               String      @id @default(cuid())
  userId           String      @unique
  creationGoal     String
  role             String
  teamSize         String
  monthlyVolume    String
  discoverySource  String
  completedAt      DateTime    @default(now())

  userProfile UserProfile @relation(fields: [userId], references: [id])

  @@index([completedAt])
  @@deny('all', auth() == null)
  @@allow('all', userId == auth().id)
}

// ── ApiKey (MCP / programmatic access) ────────────────────────────────────────
//
// One row per user-minted API key. The full key is shown once at creation and
// never stored — only its SHA-256 hash (`keyHash`) and a display `prefix`.
// Authentication: hash the presented Bearer token and look it up by `keyHash`;
// reject when `revokedAt` is set.
//
// NOTE: mapped to "PitchApiKey" because the shared dev database already has an
// unrelated "ApiKey" table owned by the launch-videos service.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String                       // Clerk user ID
  name       String
  prefix     String                       // first ~12 chars of the key, for display
  keyHash    String    @unique            // SHA-256 hex of the full key
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  userProfile UserProfile @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("PitchApiKey")

  @@deny('all', auth() == null)
  @@allow('all', userId == auth().id)
}

// ── BrowserProfile ────────────────────────────────────────────────────────────
//
// One stealth-browser profile per user. The profile dir is a real Chromium
// user-data-dir managed by CloakBrowser — cookies, localStorage, IndexedDB and
// site permissions persist across sessions and across jobs.
//
// `profileDir` is the absolute path on the host that runs the browser-host
// service (Phase 1: dev machine; Phase 2: shared volume; Phase 3: rehydrated
// from `storageStateKey` in S3 on each worker).
//
// `loggedInOrigins` is a JSON string array of origins where the user has
// completed a login flow — used to render badges on the /sessions UI.
model BrowserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  profileDir      String                     // absolute path on the browser-host
  storageStateKey String?                    // S3 key for the serialised storage_state.json (phase 3)
  loggedInOrigins String   @default("[]")    // JSON: string[]
  lastSyncedAt    DateTime?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userProfile UserProfile      @relation(fields: [userId], references: [id])
  sessions    BrowserSession[]

  @@deny('all', auth() == null)
  @@allow('all', userId == auth().id)
}

// ── BrowserSession ────────────────────────────────────────────────────────────
//
// A transient handle on a running CloakBrowser process. One row per
// "Authenticate" click. Lifecycle:
//   STARTING → READY → CLOSED   (happy path)
//                  ↘ ERROR      (spawn or capture failure)
//                  ↘ EXPIRED    (idle GC)
//
// `cdpPort` is the local CDP debugging port; agent-browser connects here.
// `noVncUrl` is filled in Phase 2 when we start streaming the headed window.
model BrowserSession {
  id          String    @id @default(cuid())
  userId      String
  profileId   String
  status      String    @default("STARTING") // STARTING | READY | CLOSED | ERROR | EXPIRED
  startUrl    String?
  cdpPort     Int?
  noVncUrl    String?
  // The CloakBrowser manager this session runs on. Every studio node has its
  // own manager, so the VNC proxy must bridge to the one that holds the profile.
  managerUrl  String?
  pid         Int?
  error       String?
  startedAt   DateTime  @default(now())
  readyAt     DateTime?
  closedAt    DateTime?
  expiresAt   DateTime

  userProfile    UserProfile    @relation(fields: [userId], references: [id])
  browserProfile BrowserProfile @relation(fields: [profileId], references: [id])

  @@index([userId, status])

  @@deny('all', auth() == null)
  @@allow('all', userId == auth().id)
}

// ── Subscription (Dodo recurring product) ────────────────────────────────────
//
// One row per active or historical Dodo subscription for a user.
// When a subscription is created or renewed we also write a CreditTransaction.
model Subscription {
  id              String    @id @default(cuid())
  userId          String                        // Clerk user ID
  dodoSubscriptionId String @unique             // Dodo subscription_id (sub_xxx)
  planKey         String                        // "starter" | "pro" | "enterprise"
  status          String    @default("active")  // active | cancelled | past_due | paused
  creditsPerCycle Int                           // credits granted each billing cycle
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userProfile     UserProfile @relation(fields: [userId], references: [id])
  creditTransactions CreditTransaction[]

  @@index([userId])
  @@index([dodoSubscriptionId])
}

// ── TopUpPurchase (Dodo one-time payment) ─────────────────────────────────────
//
// One row per completed one-time top-up purchase.
// Each row represents real money spent — used for audit and support.
model TopUpPurchase {
  id            String   @id @default(cuid())
  userId        String                       // Clerk user ID
  dodoPaymentId String   @unique             // Dodo payment_id (pay_xxx)
  packKey       String                       // "topup_10" | "topup_50"
  credits       Int                          // credits granted
  amountUsd     Float                        // amount paid in USD
  createdAt     DateTime @default(now())

  userProfile   UserProfile @relation(fields: [userId], references: [id])
  creditTransactions CreditTransaction[]

  @@index([userId])
  @@index([dodoPaymentId])
}

// ── CreditTransaction (immutable ledger) ──────────────────────────────────────
//
// Every credit movement in the system is recorded here.
// The current balance is always SUM(delta) WHERE userId = ?
// — there is no separate mutable balance counter.
//
// type values:
//   subscription_grant  — monthly credits from an active subscription cycle
//   topup_grant         — credits from a one-time top-up purchase
//   usage               — credits spent on a job
//   refund              — credits returned when a job fails
//   admin_adjustment    — manual grant or deduction by an admin
//   promo               — promotional credits (e.g. beta sign-up bonus)
model CreditTransaction {
  id             String   @id @default(cuid())
  userId         String                        // Clerk user ID
  delta          Int                           // positive = credit, negative = debit
  type           String                        // see values above
  description    String                        // human-readable reason
  projectId      String?                       // set for usage / refund transactions (studio projects)
  subscriptionId String?                       // set for subscription_grant transactions (FK to Subscription.id)
  topUpId        String?                       // set for topup_grant transactions (FK to TopUpPurchase.id)
  idempotencyKey String?  @unique              // prevents double-grants (e.g. dodo event id)
  // Which isolated balance/surface owns the transaction: "product", "api", or
  // "discord". Discord promo grants and spend never enter the main balance.
  channel        String   @default("product")
  createdAt      DateTime @default(now())

  userProfile    UserProfile    @relation(fields: [userId], references: [id])
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id])
  topUp          TopUpPurchase? @relation(fields: [topUpId], references: [id])

  @@index([userId])
  @@index([idempotencyKey])
  // Serves the date-range usage query, which scans one user's recent ledger.
  @@index([userId, createdAt])
}

// ── Video editions ────────────────────────────────────────────────────────────────────────────

// ── Affiliate Program ────────────────────────────────────────────────────────────────────────────

// One record per influencer who has joined the affiliate program
model Affiliate {
  id            String   @id @default(cuid())
  userId        String   @unique        // Clerk user ID
  code          String   @unique        // e.g. "MUKUND-X7K2" — human-readable, URL-safe
  status        String   @default("active")  // active | suspended | pending
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userProfile UserProfile           @relation(fields: [userId], references: [id])
  clicks      AffiliateClick[]
  leads       AffiliateLead[]
  conversions AffiliateConversion[]
  payouts     AffiliatePayout[]
}

// A referred signup attributed to an affiliate (paid or not) — drives the
// "signups" count and rewards. One row per referred user (first-touch).
model AffiliateLead {
  id             String   @id @default(cuid())
  affiliateId    String
  clickId        String?  // which click led to this signup, if known
  referredUserId String   @unique // Clerk userId of the referred user
  createdAt      DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
}

// Every click on an affiliate link — used for analytics and attribution
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  ip          String?   // SHA-256 hashed — never raw IP (GDPR/PDPB compliant)
  userAgent   String?
  platform    String?   // e.g. "instagram" | "youtube" | "direct"
  refPage     String?   // landing page URL they arrived on
  clickedAt   DateTime  @default(now())
  convertedAt DateTime? // set when this click results in a conversion

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([clickedAt])
}

// A referred user's first purchase. Used to dedupe the purchase reward (one per
// referred user, ever) and to surface revenue driven. Rewards are paid in
// credits, not cash — there is no commission field.
model AffiliateConversion {
  id            String   @id @default(cuid())
  affiliateId   String
  clickId       String?  // which specific click led to this conversion
  referredUserId String  // Clerk userId of the person who signed up & purchased
  saleAmountUsd Float    // sale amount in USD (Dodo reports in USD cents → convert)
  status        String   @default("pending") // pending | approved | rejected
  dodoSessionId String? // Dodo Checkout session ID for audit trail
  createdAt     DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@unique([affiliateId, referredUserId]) // one reward per referred user, ever
  @@index([affiliateId])
  @@index([referredUserId])
}

// A payout request from an influencer, settled via Dodo or bank transfer
model AffiliatePayout {
  id          String   @id @default(cuid())
  affiliateId String
  amount      Float    // total USD amount
  currency    String   @default("USD")
  method      String   // "dodo" | "bank"
  status      String   @default("requested") // requested | processing | paid | failed
  reference   String?  // Dodo transfer ID or bank ref
  requestedAt DateTime @default(now())
  paidAt      DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
}

// ── Newsletter Subscribers ────────────────────────────────────────────────────

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  firstName      String?
  userId         String?   @unique
  source         String    @default("website")
  status         String    @default("subscribed")
  unsubscribeToken String? @unique @default(cuid())
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  // Allow anyone to subscribe (create) without auth
  @@allow('create', true)
  @@index([status, createdAt])
}

model NewsletterCampaign {
  id             String   @id @default(cuid())
  subject        String
  message        String
  ctaLabel       String?
  ctaUrl         String?
  sentByUserId   String
  sentByEmail    String
  sentByName     String?
  status         String   @default("sending")
  recipientCount Int
  sentCount      Int      @default(0)
  failedCount    Int      @default(0)
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  deliveries     NewsletterDelivery[]

  @@index([createdAt])
}

model NewsletterDelivery {
  id          String             @id @default(cuid())
  campaignId  String
  email       String
  firstName   String?
  status      String
  providerId  String?
  error       String?
  createdAt   DateTime           @default(now())
  campaign    NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([email])
}

// ── Studio projects ─────────────────────────────────────────────────────────

// ── Studio projects ─────────────────────────────────────────────────────────

// A studio project: one workspace directory, one resumable pi session, one
// preview. Status is derived at runtime (session busy / workspace contents),
// never stored. `outputs` is a JSON array of { kind, url, res?, label?, createdAt }.
model Project {
  id             String   @id @default(cuid())
  userId         String   // Clerk user id — owner of the workspace
  flow           String   // launch-video | demo-video | deck | recording-edit
  name           String   // slug; the workspace directory name (unique per user + flow)
  title          String
  prompt         String   @default("")
  options        String   @default("{}") // JSON
  sessionFile    String?  // pi session file, set once the agent has spoken
  creditsCharged Int      @default(0) // credits billed so far (usage, not upfront)
  usageUsd       Float    @default(0) // measured cost: model spend + render seconds
  outputs        String   @default("[]") // JSON Output[]
  thumbnailUrl   String?
  lastError      String?
  isPublic       Boolean  @default(false)
  shareSlug      String?  @unique
  shareViews     Int      @default(0)
  // Where the project was started: "app", "api" (a /v1 key), or "discord".
  // Stamped on the row so usage can be attributed long after the fact.
  source         String   @default("app")
  // ── Placement (apps/api/src/worker/) ──────────────────────────────────────
  // The studio worker that holds this project's session and hot workspace
  // copy, fenced by the epoch of the worker boot that took the lease. A row
  // whose worker is dead (stale heartbeat) or whose epoch no longer matches
  // is unowned and can be placed again.
  workerId       String?
  workerEpoch    Int?
  leasedAt       DateTime?
  // The worker that last held it: placement prefers it while it is alive,
  // because its disk is still warm.
  lastWorkerId   String?
  // Durable copy of the workspace in object storage, keyed by version; 0 means
  // nothing has been checkpointed yet. A worker whose local copy is not at
  // this version restores before opening the project.
  workspaceVersion      Int       @default(0)
  workspaceCheckpointAt DateTime?
  // Cheap, worker-maintained caches of what the workspace holds, for lists
  // that must not open every project: the kind of artifact on disk and when
  // the current turn started (null when idle).
  artifactKind   String?
  busyAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creditTransactions CreditTransaction[]

  @@unique([userId, flow, name])
  @@index([userId])
  @@index([workerId])

  // Deny everything when not authenticated (public share pages read via the base client).
  @@deny('all', auth() == null && isPublic != true)
  @@allow('all', userId == auth().id)
  @@allow('read', isPublic == true && auth() == null)
}

// ── Render jobs ─────────────────────────────────────────────────────────────
// A heavy host action (a capture, an encode, a transcription) queued by a
// worker for the render tier. The workspace it needs is the checkpoint at
// workspaceVersion; what it produced comes back as renders/<id>/output.tar
// in the workspace bucket. Sessions are never queued — only these are.
model RenderJob {
  id               String    @id @default(cuid())
  projectId        String
  // Host action name (registered with remote: true) and its JSON params.
  action           String
  params           String    @default("{}")
  workspaceVersion Int
  // queued | running | done | failed | cancelled
  status           String    @default("queued")
  stage            String?
  progress         Int       @default(0)
  result           String?
  error            String?
  cancelRequested  Boolean   @default(false)
  // The render pod that claimed it; a stale heartbeat hands it to another.
  renderer         String?
  attempts         Int       @default(0)
  createdAt        DateTime  @default(now())
  startedAt        DateTime?
  heartbeatAt      DateTime?
  finishedAt       DateTime?

  @@index([status, createdAt])
  @@index([projectId])
}

// ── Studio workers ──────────────────────────────────────────────────────────
// One row per studio worker process (apps/api/src/worker/registry.ts). A
// worker upserts its row on boot with a new epoch, heartbeats every few
// seconds, and is considered dead once the heartbeat is older than the lease
// TTL. Placement (worker/lease.ts) reads only this table and the Project
// lease columns, so any number of API replicas reach the same answer.

model StudioWorker {
  id          String   @id
  // Private base URL other processes reach it at (never a browser-supplied host).
  url         String
  // Concurrent projects it will hold.
  slots       Int      @default(4)
  // Bumped every boot: leases taken by an earlier boot are void.
  epoch       Int      @default(1)
  draining    Boolean  @default(false)
  version     String?
  startedAt   DateTime @default(now())
  heartbeatAt DateTime @default(now())

  @@deny('all', true)
}

// ── Outbound Webhooks ───────────────────────────────────────────────────────

model WebhookEndpoint {
  id         String    @id @default(cuid())
  userId     String
  url        String
  secret     String
  events     String    @default("[\"job.completed\",\"job.failed\"]")
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userProfile UserProfile       @relation(fields: [userId], references: [id])
  deliveries  WebhookDelivery[]

  @@index([userId])

  @@deny('all', auth() == null)
  @@allow('all', userId == auth().id)
}

model WebhookDelivery {
  id           String           @id @default(cuid())
  endpointId   String?
  userId       String
  jobId        String
  event        String
  payload      String
  status       String           @default("PENDING") // PENDING | SUCCESS | FAILED
  statusCode   Int?
  responseBody String?
  error        String?
  attempts     Int              @default(0)
  maxAttempts  Int              @default(5)
  nextRetryAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  userProfile  UserProfile      @relation(fields: [userId], references: [id])
  endpoint     WebhookEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([jobId])
  @@index([status])

  @@deny('all', auth() == null)
  @@allow('all', userId == auth().id)
}
