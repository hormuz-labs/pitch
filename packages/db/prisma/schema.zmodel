generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

plugin prisma {
  provider = "@core/prisma"
  output = "./schema.prisma"
}

plugin enhancer {
  provider = "@core/enhancer"
  output = "../node_modules/@zenstackhq/runtime"
}

// Dummy user model for ZenStack auth type-checking
// We use Clerk for auth, so this doesn't need to be in the database
model User {
  id    String @id
  orgId String?

  @@auth()
  @@ignore()
}

// Stores Clerk user details synced on sign-in
model UserProfile {
  id        String   @id           // Clerk user ID
  email     String
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Credit balance per tenant (orgId or userId when no org)
model CreditBalance {
  tenantId  String   @id         // orgId if in an org, otherwise userId
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  transactions CreditTransaction[]
}

// Immutable ledger of every credit change
model CreditTransaction {
  id        String   @id @default(cuid())
  tenantId  String
  delta     Int                        // positive = added, negative = deducted
  reason    String                     // e.g. "job_created", "job_failed_refund", "admin_adjustment"
  jobId     String?                    // reference to the related job if applicable
  createdAt DateTime @default(now())

  balance   CreditBalance @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
}

model Job {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  status     String
  videoUrl   String?
  audioUrl   String?
  parameters String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])

  // Access policies
  // User must be logged in to do anything
  @@deny('all', auth() == null)

  // A user can read/write jobs that belong to their organization, or their own personal jobs if no org
  // The auth() object will be passed in when enhancing the prisma client:
  // enhance(prisma, { user: { id: userId, orgId: orgId } })
  @@allow('all', auth().orgId != null && orgId == auth().orgId)
  @@allow('all', auth().orgId == null && userId == auth().id)
}

// ── Affiliate Program ─────────────────────────────────────────────────────────

// One record per influencer who has joined the affiliate program
model Affiliate {
  id            String   @id @default(cuid())
  userId        String   @unique        // Clerk user ID
  code          String   @unique        // e.g. "MUKUND-X7K2" — human-readable, URL-safe
  commissionPct Float    @default(20.0) // Percentage of sale credited as commission
  status        String   @default("active")  // active | suspended | pending
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clicks      AffiliateClick[]
  conversions AffiliateConversion[]
  payouts     AffiliatePayout[]
}

// Every click on an affiliate link — used for analytics and attribution
model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  ip          String?   // SHA-256 hashed — never raw IP (GDPR/PDPB compliant)
  userAgent   String?
  platform    String?   // e.g. "instagram" | "youtube" | "direct"
  refPage     String?   // landing page URL they arrived on
  clickedAt   DateTime  @default(now())
  convertedAt DateTime? // set when this click results in a conversion

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([clickedAt])
}

// A confirmed sale attributed to an influencer (first purchase only)
model AffiliateConversion {
  id            String   @id @default(cuid())
  affiliateId   String
  clickId       String?  // which specific click led to this conversion
  referredUserId String  // Clerk userId of the person who signed up & purchased
  saleAmountUsd Float    // sale amount in USD (Stripe reports in USD cents → convert)
  commissionAmt Float    // saleAmountUsd * commissionPct / 100
  status        String   @default("pending") // pending | approved | paid | rejected
  stripeSessionId String? // Stripe Checkout session ID for audit trail
  createdAt     DateTime @default(now())

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@unique([affiliateId, referredUserId]) // one commission per referred user, ever
  @@index([affiliateId])
  @@index([referredUserId])
}

// A payout request from an influencer, settled via Stripe Connect or bank transfer
model AffiliatePayout {
  id          String   @id @default(cuid())
  affiliateId String
  amount      Float    // total USD amount
  currency    String   @default("USD")
  method      String   // "stripe" | "bank"
  status      String   @default("requested") // requested | processing | paid | failed
  reference   String?  // Stripe transfer ID or bank ref
  requestedAt DateTime @default(now())
  paidAt      DateTime?

  affiliate Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
}
