// DO NOT MODIFY THIS FILE                                                                  //
// This file is automatically generated by ZenStack CLI and should not be manually updated. //
//////////////////////////////////////////////////////////////////////////////////////////////

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id String @id()

  @@ignore()
}

model UserProfile {
  id                 String              @id()
  email              String
  firstName          String?
  lastName           String?
  imageUrl           String?
  role               String              @default("user")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt()
  subscriptions      Subscription[]
  topUpPurchases     TopUpPurchase[]
  creditTransactions CreditTransaction[]
  jobs               Job[]
  affiliate          Affiliate?
}

model Subscription {
  id                 String              @id() @default(cuid())
  userId             String
  dodoSubscriptionId String              @unique()
  planKey            String
  status             String              @default("active")
  creditsPerCycle    Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt()
  userProfile        UserProfile         @relation(fields: [userId], references: [id])
  creditTransactions CreditTransaction[]

  @@index([userId])
  @@index([dodoSubscriptionId])
}

model TopUpPurchase {
  id                 String              @id() @default(cuid())
  userId             String
  dodoPaymentId      String              @unique()
  packKey            String
  credits            Int
  amountUsd          Float
  createdAt          DateTime            @default(now())
  userProfile        UserProfile         @relation(fields: [userId], references: [id])
  creditTransactions CreditTransaction[]

  @@index([userId])
  @@index([dodoPaymentId])
}

model CreditTransaction {
  id             String         @id() @default(cuid())
  userId         String
  delta          Int
  type           String
  description    String
  jobId          String?
  subscriptionId String?
  topUpId        String?
  idempotencyKey String?        @unique()
  createdAt      DateTime       @default(now())
  userProfile    UserProfile    @relation(fields: [userId], references: [id])
  job            Job?           @relation(fields: [jobId], references: [id])
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id])
  topUp          TopUpPurchase? @relation(fields: [topUpId], references: [id])

  @@index([userId])
  @@index([idempotencyKey])
}

model Job {
  id                 String              @id() @default(cuid())
  userId             String
  status             String
  videoUrl           String?
  audioUrl           String?
  thumbnailUrl       String?
  parameters         String
  phases             String?
  error              String?
  workerId           String?
  cost               Float               @default(0)
  rating             String?
  feedback           String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt()
  userProfile        UserProfile         @relation(fields: [userId], references: [id])
  creditTransactions CreditTransaction[]

  @@index([userId])
}

model Affiliate {
  id            String                @id() @default(cuid())
  userId        String                @unique()
  code          String                @unique()
  commissionPct Float                 @default(20.0)
  status        String                @default("active")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt()
  userProfile   UserProfile           @relation(fields: [userId], references: [id])
  clicks        AffiliateClick[]
  conversions   AffiliateConversion[]
  payouts       AffiliatePayout[]
}

model AffiliateClick {
  id          String    @id() @default(cuid())
  affiliateId String
  ip          String?
  userAgent   String?
  platform    String?
  refPage     String?
  clickedAt   DateTime  @default(now())
  convertedAt DateTime?
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([clickedAt])
}

model AffiliateConversion {
  id             String    @id() @default(cuid())
  affiliateId    String
  clickId        String?
  referredUserId String
  saleAmountUsd  Float
  commissionAmt  Float
  status         String    @default("pending")
  dodoSessionId  String?
  createdAt      DateTime  @default(now())
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id])

  @@unique([affiliateId, referredUserId])
  @@index([affiliateId])
  @@index([referredUserId])
}

model AffiliatePayout {
  id          String    @id() @default(cuid())
  affiliateId String
  amount      Float
  currency    String    @default("USD")
  method      String
  status      String    @default("requested")
  reference   String?
  requestedAt DateTime  @default(now())
  paidAt      DateTime?
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
}

model NewsletterSubscriber {
  id        String   @id() @default(cuid())
  email     String   @unique()
  createdAt DateTime @default(now())
}
