datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model User {
  id String @id()

  @@ignore()
}

model UserProfile {
  id                   String                @id()
  email                String
  firstName            String?
  lastName             String?
  imageUrl             String?
  discordUserId        String?               @unique()
  role                 String                @default("user")
  username             String?               @unique()
  emailNotifications   Boolean               @default(true)
  browserNotifications Boolean               @default(false)
  gptEnabled           Boolean               @default(false)
  onboardingSkippedAt  DateTime?
  discordPromoSeenAt   DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt()
  subscriptions        Subscription[]
  topUpPurchases       TopUpPurchase[]
  creditTransactions   CreditTransaction[]
  affiliate            Affiliate?
  browserProfile       BrowserProfile?
  browserSessions      BrowserSession[]
  apiKeys              ApiKey[]
  webhookEndpoints     WebhookEndpoint[]
  webhookDeliveries    WebhookDelivery[]
  onboardingSurvey     OnboardingSurvey?
  promoRedemptions     PromoCodeRedemption[]
}

model DiscordRewardClaim {
  id                  String   @id() @default(cuid())
  campaignId          String
  userId              String
  discordUserId       String
  guildId             String
  credits             Int
  creditTransactionId String   @unique()
  claimedAt           DateTime @default(now())

  @@unique([campaignId, userId])
  @@unique([campaignId, discordUserId])
  @@index([claimedAt])
}

model PromoCode {
  id              String                @id() @default(cuid())
  code            String                @unique()
  credits         Int
  maxRedemptions  Int?
  redemptionCount Int                   @default(0)
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())
  redemptions     PromoCodeRedemption[]
}

model PromoCodeRedemption {
  id          String      @id() @default(cuid())
  userId      String
  codeId      String
  credits     Int
  createdAt   DateTime    @default(now())
  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCode   PromoCode   @relation(fields: [codeId], references: [id], onDelete: Cascade)

  @@unique([userId, codeId])
  @@index([codeId])
}

model OnboardingSurvey {
  id              String      @id() @default(cuid())
  userId          String      @unique()
  creationGoal    String
  role            String
  teamSize        String
  monthlyVolume   String
  discoverySource String
  completedAt     DateTime    @default(now())
  userProfile     UserProfile @relation(fields: [userId], references: [id])

  @@index([completedAt])
}

model ApiKey {
  id          String      @id() @default(cuid())
  userId      String
  name        String
  prefix      String
  keyHash     String      @unique()
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime    @default(now())
  userProfile UserProfile @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("PitchApiKey")
}

model BrowserProfile {
  id              String           @id() @default(cuid())
  userId          String           @unique()
  profileDir      String
  storageStateKey String?
  loggedInOrigins String           @default("[]")
  lastSyncedAt    DateTime?
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt()
  userProfile     UserProfile      @relation(fields: [userId], references: [id])
  sessions        BrowserSession[]
}

model BrowserSession {
  id             String         @id() @default(cuid())
  userId         String
  profileId      String
  status         String         @default("STARTING")
  startUrl       String?
  cdpPort        Int?
  noVncUrl       String?
  managerUrl     String?
  pid            Int?
  error          String?
  startedAt      DateTime       @default(now())
  readyAt        DateTime?
  closedAt       DateTime?
  expiresAt      DateTime
  userProfile    UserProfile    @relation(fields: [userId], references: [id])
  browserProfile BrowserProfile @relation(fields: [profileId], references: [id])

  @@index([userId, status])
}

model Subscription {
  id                 String              @id() @default(cuid())
  userId             String
  dodoSubscriptionId String              @unique()
  planKey            String
  status             String              @default("active")
  creditsPerCycle    Int
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt()
  userProfile        UserProfile         @relation(fields: [userId], references: [id])
  creditTransactions CreditTransaction[]

  @@index([userId])
  @@index([dodoSubscriptionId])
}

model TopUpPurchase {
  id                 String              @id() @default(cuid())
  userId             String
  dodoPaymentId      String              @unique()
  packKey            String
  credits            Int
  amountUsd          Float
  createdAt          DateTime            @default(now())
  userProfile        UserProfile         @relation(fields: [userId], references: [id])
  creditTransactions CreditTransaction[]

  @@index([userId])
  @@index([dodoPaymentId])
}

model CreditTransaction {
  id             String         @id() @default(cuid())
  userId         String
  delta          Int
  type           String
  description    String
  projectId      String?
  subscriptionId String?
  topUpId        String?
  idempotencyKey String?        @unique()
  channel        String         @default("product")
  createdAt      DateTime       @default(now())
  userProfile    UserProfile    @relation(fields: [userId], references: [id])
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id])
  topUp          TopUpPurchase? @relation(fields: [topUpId], references: [id])

  @@index([userId])
  @@index([idempotencyKey])
  @@index([userId, createdAt])
}

model Affiliate {
  id          String                @id() @default(cuid())
  userId      String                @unique()
  code        String                @unique()
  status      String                @default("active")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt()
  userProfile UserProfile           @relation(fields: [userId], references: [id])
  clicks      AffiliateClick[]
  leads       AffiliateLead[]
  conversions AffiliateConversion[]
  payouts     AffiliatePayout[]
}

model AffiliateLead {
  id             String    @id() @default(cuid())
  affiliateId    String
  clickId        String?
  referredUserId String    @unique()
  createdAt      DateTime  @default(now())
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
}

model AffiliateClick {
  id          String    @id() @default(cuid())
  affiliateId String
  ip          String?
  userAgent   String?
  platform    String?
  refPage     String?
  clickedAt   DateTime  @default(now())
  convertedAt DateTime?
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
  @@index([clickedAt])
}

model AffiliateConversion {
  id             String    @id() @default(cuid())
  affiliateId    String
  clickId        String?
  referredUserId String
  saleAmountUsd  Float
  status         String    @default("pending")
  dodoSessionId  String?
  createdAt      DateTime  @default(now())
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id])

  @@unique([affiliateId, referredUserId])
  @@index([affiliateId])
  @@index([referredUserId])
}

model AffiliatePayout {
  id          String    @id() @default(cuid())
  affiliateId String
  amount      Float
  currency    String    @default("USD")
  method      String
  status      String    @default("requested")
  reference   String?
  requestedAt DateTime  @default(now())
  paidAt      DateTime?
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])

  @@index([affiliateId])
}

model NewsletterSubscriber {
  id               String    @id() @default(cuid())
  email            String    @unique()
  firstName        String?
  userId           String?   @unique()
  source           String    @default("website")
  status           String    @default("subscribed")
  unsubscribeToken String?   @unique() @default(cuid())
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt()

  @@index([status, createdAt])
}

model NewsletterCampaign {
  id             String               @id() @default(cuid())
  subject        String
  message        String
  ctaLabel       String?
  ctaUrl         String?
  sentByUserId   String
  sentByEmail    String
  sentByName     String?
  status         String               @default("sending")
  recipientCount Int
  sentCount      Int                  @default(0)
  failedCount    Int                  @default(0)
  createdAt      DateTime             @default(now())
  completedAt    DateTime?
  deliveries     NewsletterDelivery[]

  @@index([createdAt])
}

model NewsletterDelivery {
  id         String             @id() @default(cuid())
  campaignId String
  email      String
  firstName  String?
  status     String
  providerId String?
  error      String?
  createdAt  DateTime           @default(now())
  campaign   NewsletterCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([email])
}

model Project {
  id                    String              @id() @default(cuid())
  userId                String
  flow                  String
  name                  String
  title                 String
  prompt                String              @default("")
  options               String              @default("{}")
  sessionFile           String?
  creditsCharged        Int                 @default(0)
  usageUsd              Float               @default(0)
  outputs               String              @default("[]")
  thumbnailUrl          String?
  lastError             String?
  isPublic              Boolean             @default(false)
  shareSlug             String?             @unique()
  shareViews            Int                 @default(0)
  source                String              @default("app")
  workerId              String?
  workerEpoch           Int?
  leasedAt              DateTime?
  lastWorkerId          String?
  workspaceVersion      Int                 @default(0)
  workspaceCheckpointAt DateTime?
  artifactKind          String?
  busyAt                DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt()
  creditTransactions    CreditTransaction[]

  @@unique([userId, flow, name])
  @@index([userId])
  @@index([workerId])
}

model StudioWorker {
  id          String   @id()
  url         String
  slots       Int      @default(4)
  epoch       Int      @default(1)
  draining    Boolean  @default(false)
  version     String?
  startedAt   DateTime @default(now())
  heartbeatAt DateTime @default(now())
}

model WebhookEndpoint {
  id          String            @id() @default(cuid())
  userId      String
  url         String
  secret      String
  events      String            @default("[\"job.completed\",\"job.failed\"]")
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt()
  userProfile UserProfile       @relation(fields: [userId], references: [id])
  deliveries  WebhookDelivery[]

  @@index([userId])
}

model WebhookDelivery {
  id           String           @id() @default(cuid())
  endpointId   String?
  userId       String
  jobId        String
  event        String
  payload      String
  status       String           @default("PENDING")
  statusCode   Int?
  responseBody String?
  error        String?
  attempts     Int              @default(0)
  maxAttempts  Int              @default(5)
  nextRetryAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt()
  userProfile  UserProfile      @relation(fields: [userId], references: [id])
  endpoint     WebhookEndpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([jobId])
  @@index([status])
}
