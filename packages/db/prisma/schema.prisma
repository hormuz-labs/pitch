datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id    String  @id()
  orgId String?

  @@ignore()
}

model Job {
  id         String   @id() @default(cuid())
  userId     String
  orgId      String
  status     String
  videoUrl   String?
  audioUrl   String?
  parameters String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt()

  @@index([orgId])
}
