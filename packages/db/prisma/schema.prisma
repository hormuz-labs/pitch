generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id         String   @id @default(cuid())
  userId     String
  orgId      String
  status     String
  videoUrl   String?
  audioUrl   String?
  parameters String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
