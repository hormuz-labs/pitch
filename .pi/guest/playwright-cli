#!/usr/bin/env node
/*
 * `playwright-cli`, as the sandboxed shell sees it.
 *
 * The shell has no browser, no network, and no daemon access inside bubblewrap;
 * the demo-video recording runs outside the sandbox, connected to the browser over CDP.
 *
 * This guest binary acts as a transparent client: it forwards every playwright-cli
 * command over PITCH_SOCKET to the studio host (`pitch demo bash`), unpackages
 * any structured stdout/stderr, and returns the real result and exit code.
 *
 * If PITCH_SOCKET is not set, it falls back to looking for an external playwright-cli
 * binary on the host (outside /opt/pitch) so it can still function if run unconfined.
 */
'use strict'
const net = require('node:net')
const { execFileSync } = require('node:child_process')

const socket = process.env.PITCH_SOCKET
if (!socket) {
  // If not inside the sandbox with PITCH_SOCKET, fall back to system playwright-cli
  try {
    const whichOut = execFileSync('which', ['-a', 'playwright-cli'], { encoding: 'utf8' })
    const bins = whichOut.split('\n').filter(Boolean).filter(p => !p.startsWith('/opt/pitch') && p !== __filename)
    if (bins.length > 0) {
      try {
        execFileSync(bins[0], process.argv.slice(2), { stdio: 'inherit' })
        process.exit(0)
      } catch (err) {
        process.exit(err.status ?? 1)
      }
    }
  } catch {}
  process.stderr.write('playwright-cli: PITCH_SOCKET is not set — this shell has no line to the studio.\n')
  process.exit(2)
}

function shellQuote(arg) {
  if (/^[a-zA-Z0-9_./:=+-]+$/.test(arg)) return arg
  return '"' + arg.replace(/(["\\$`])/g, '\\$1') + '"'
}

const rawArgs = process.argv.slice(2)
const command = 'playwright-cli ' + rawArgs.map(shellQuote).join(' ')

const conn = net.connect(socket)
let buffer = ''
let exit = null

conn.on('connect', () => {
  conn.write(`${JSON.stringify({ argv: ['demo', 'bash', '--command', command] })}\n`)
})

conn.on('data', chunk => {
  buffer += chunk.toString('utf8')
  let nl = buffer.indexOf('\n')
  while (nl !== -1) {
    const line = buffer.slice(0, nl)
    buffer = buffer.slice(nl + 1)
    nl = buffer.indexOf('\n')
    if (!line) continue
    let frame
    try {
      frame = JSON.parse(line)
    } catch {
      continue
    }
    if (typeof frame.out === 'string') {
      const text = frame.out
      try {
        const parsed = JSON.parse(text.trim())
        if (parsed && typeof parsed === 'object' && typeof parsed.stdout === 'string') {
          if (parsed.stdout) {
            process.stdout.write(parsed.stdout.endsWith('\n') ? parsed.stdout : parsed.stdout + '\n')
          }
          if (parsed.stderr) {
            process.stderr.write(parsed.stderr.endsWith('\n') ? parsed.stderr : parsed.stderr + '\n')
          }
          continue
        }
      } catch {}
      process.stdout.write(text)
    }
    if (typeof frame.err === 'string') process.stderr.write(frame.err)
    if (typeof frame.exit === 'number') exit = frame.exit
  }
})

conn.on('error', err => {
  process.stderr.write(`playwright-cli: cannot reach the studio (${err.code || err.message}).\n`)
  process.exit(2)
})

conn.on('close', () => process.exit(exit ?? 1))
