# Database connection string (Local Postgres via Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5433/silverfish?schema=public"

# Clerk Auth Keys (Required for User & Tenant Management)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Gemini API Keys (Required for Auto-Demo Generator Skill)
# Get your key from Google AI Studio
GEMINI_API_KEY="your_gemini_api_key_here"

# Redis connection for BullMQ (Worker & API)
REDIS_URL="redis://localhost:6379"

# API Port
PORT=3000

# OpenCode Server (Webhook target for the Worker)
OPENCODE_SERVER_URL="http://localhost:8080/generate"

# MinIO / S3-compatible storage (used by job-cli via packages/storage)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_ENDPOINT="http://localhost:9000"
MINIO_BUCKET="silverfish-videos"
# The public base URL MinIO uses to serve files (set this to your server's public address)
MINIO_PUBLIC_URL="http://localhost:9000"

#For lips sync of video/avatar 
SYNCLABS_API_KEY="yourSyncApiKeyHere"
CLOUDINARY_URL="cloudinaryUrlHere"
