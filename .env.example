# Database connection string (Local Postgres via Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5433/pitch?schema=public"

# Clerk Auth Keys (Required for User & Tenant Management)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
# Optional browser-side GIPHY Search key for storyboard GIF overlays.
# GIPHY requires Search API calls to originate from the client.
VITE_GIPHY_API_KEY="your_giphy_web_api_key_here"

# PostHog browser analytics (project key is safe to expose to the web client).
# Use https://eu.i.posthog.com instead when the PostHog project is in the EU region.
VITE_POSTHOG_KEY="phx_your_posthog_project_key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your_clerk_webhook_signing_secret"

# Gemini API Keys (Required for Auto-Demo Generator Skill)
# Get your key from Google AI Studio
GEMINI_API_KEY="your_gemini_api_key_here"
# Alias required by the Vercel AI SDK's Google provider
GOOGLE_GENERATIVE_AI_API_KEY="your_gemini_api_key_here"

# ElevenLabs: generated music beds and sound effects (`pitch motion music|sound`), and
# narration when .pi/audio.json says tts.provider = "elevenlabs". Music needs a paid plan.
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
# ELEVENLABS_MUSIC_TIMEOUT_MS=600000
# ELEVENLABS_SFX_TIMEOUT_MS=120000
# ELEVENLABS_TTS_TIMEOUT_MS=180000

# Pexels: licensed stock footage and photos for promo films and ads
# (`pitch motion stock`). Optional; without it the agent uses uploads and
# engine-built shots. Free key: https://www.pexels.com/api/
PEXELS_API_KEY="your_pexels_api_key_here"

# API Port
PORT=3000

# Public app URL (used by Dodo to build success/cancel redirect URLs)
# In production set to: https://trypitch.co
APP_URL="http://localhost:5173"

# Studio (apps/api): every project is a pi agent session; launch/deck run sandboxed in Gondolin
# Where project workspaces live (default <repo>/projects)
# PROJECTS_DIR=/app/projects
# Model the studio agent runs on; pi reads GEMINI_API_KEY for the google provider.
STUDIO_MODEL="google/gemini-3.8-flash"
# Optional relative credit prices by model. Unlisted models use 1x.
STUDIO_MODEL_CREDIT_MULTIPLIERS='{"azure-apim/gpt-5.5":1.5,"azure-apim/gpt-5.6-luna":0.75,"azure-apim/gpt-5.6-terra":1,"azure-apim/gpt-5.6-sol":1,"azure-apim/gpt-6-sol":1,"azure-apim/gpt-6.1-sol":1,"azure-apim/gpt-6-astra":2}'
# Platform margin applied after model and host-compute costs (default 1.25 = 25%).
STUDIO_PLATFORM_MARGIN=1.25
# Gemini Omni (video_generate) provider cost in USD per generated second, by
# resolution. Billed only when a clip is actually generated, on any chat model.
# OMNI_USD_PER_SECOND='{"360p":0.05,"720p":0.1,"1080p":0.15,"4k":0.4}'
# Allowlist for the composer, comma-separated `provider/id` specs in menu order.
# Default: Gemini 3.8 Flash, Gemini 3.1 Pro, GPT-5.4 mini/full,
# Azure GPT-5.5/5.6 Luna/Terra/Sol, GPT-6 Sol/Astra and GPT-6.1 Sol.
# GPT is disabled per user by default. Enable it in Admin > Users > GPT access.
# A provider key alone never grants GPT access.
# OPENAI_API_KEY="sk-..."
# Primary is preferred; secondary is used when primary is absent.
# AZURE_APIM_PRIMARY_KEY="..."
# AZURE_APIM_SECONDARY_KEY="..."

# Generated footage (video_generate). Uses the same GEMINI_API_KEY.
# OMNI_MODEL="gemini-omni-1.1-flash"
# OMNI_TIMEOUT_MS=900000
# Reasoning tokens are included in metered model usage; medium balances quality and cost.
STUDIO_THINKING="medium"
# Node binary for the launch-video scripts when the API runs under Bun (default: `node` on PATH)
# STUDIO_NODE=/usr/bin/node
# Where pi keeps session files (default ~/.pi/agent). Persist it in production.
# PI_AGENT_DIR=/root/.pi/agent
# Sandbox VM sizing / idle shutdown
# GONDOLIN_MEMORY=1G
# GONDOLIN_CPUS=2
# GONDOLIN_IDLE_MS=600000
# ── Scaling (docs/studio-architecture.md → Scaling) ─────────────────────────
# One image, four roles. `all` (default) is the API and a worker in one
# process; `api` replicas hold no projects; `worker` nodes own them; `render`
# pods hold nothing and run the heavy host actions workers queue.
# STUDIO_ROLE=all
# Stable id and private URL other processes reach this worker at. The URL is
# configuration, never a request header: API replicas proxy authenticated
# traffic to whatever it says. Defaults: the hostname, http://<hostname>:$PORT.
# STUDIO_WORKER_ID=worker-1
# STUDIO_WORKER_URL=http://10.0.0.12:3000
# Concurrent projects one worker holds. A held project is a pi session and a
# watcher — memory, not CPU — so this is high; the CPU work is elsewhere.
# STUDIO_WORKER_SLOTS=16
# Where heavy host actions run (a capture, an encode, whisper): `remote`
# queues them as RenderJobs for render pods and waits, `local` runs them in
# this process. Default: remote on a worker with checkpoints, else local.
# STUDIO_RENDER=local
# The render role: id, jobs at once, how long a worker waits on a job.
# STUDIO_RENDER_ID=render-1
# STUDIO_RENDER_CONCURRENCY=1
# STUDIO_RENDER_TIMEOUT_MS=2700000
# In a cluster, the API sets the render Deployment's replicas itself: name
# the Deployment (same namespace as the pod) and it scales 0–8 with the
# queue, down only after ten quiet minutes. Unset = no scaling from here.
# STUDIO_RENDER_SCALE_TARGET=pitch-render
# STUDIO_RENDER_SCALE_MIN=0
# STUDIO_RENDER_SCALE_MAX=8
# STUDIO_RENDER_SCALE_IDLE_MS=600000
# Browser process, isolated display/VNC startup, and operation deadlines.
# BROWSER_START_TIMEOUT_MS=60000
# CLOAK_BROWSER_START_TIMEOUT_MS=60000
# CLOAK_BROWSER_OPERATION_TIMEOUT_MS=30000
# VNC_START_TIMEOUT_MS=20000
# STUDIO_BROWSER_HOST_URL=http://127.0.0.1:3000
# Shared secret for the worker contract (/internal/worker). Required as soon as
# there is more than one process; the same value on every node.
# STUDIO_WORKER_TOKEN=
# Private bucket for workspace checkpoints (the durable copy of every
# workspace; restored by whichever worker takes the project next). Set to an
# empty string to disable — then the worker's disk is the only copy.
# STUDIO_WORKSPACE_BUCKET=pitch-workspaces
# Heartbeat and lease TTL; a worker silent for a TTL is dead and its projects move.
# STUDIO_HEARTBEAT_MS=5000
# STUDIO_LEASE_TTL_MS=15000
# A held project nobody touched for this long is checkpointed and released.
# STUDIO_IDLE_RELEASE_MS=1800000
# On SIGTERM, keep serving held projects until each turn ends (up to this
# long) before releasing them — what a scale-down or rollout wants. 0 (the
# default) releases everything at once and loses the turns in flight.
# STUDIO_DRAIN_MS=0
# What GET /internal/scale reports for workers (a reading; workers are a
# fixed count): free slots to keep in reserve, and the id prefix of the
# elastic workers as opposed to fixed machines on the tailnet.
# STUDIO_SCALE_HEADROOM=2
# STUDIO_SCALE_GROUP=pitch-worker-
# Signs the preview-iframe grant cookie (defaults to CLERK_SECRET_KEY).
# Must be the same on every node.
# PREVIEW_COOKIE_SECRET=
# Origin the API uses to load its own previews for thumbnails (default http://127.0.0.1:$PORT)
# STUDIO_INTERNAL_ORIGIN=
# whisper.cpp for narration alignment (motion_align): whisper-cli on PATH + a ggml model
# WHISPER_CLI=whisper-cli
# WHISPER_MODEL=/root/.cache/whisper-cpp/ggml-base.en.bin
# WHISPER_THREADS=12
# Video encoding is selected automatically: VideoToolbox on native macOS;
# NVENC, then VAAPI, on Linux; libx264 otherwise. Override only for diagnostics.
# FFMPEG_ENCODER=auto
# Linux VAAPI render node. Find its group with: stat -c '%g' /dev/dri/renderD128
# FFMPEG_VAAPI_DEVICE=/dev/dri/renderD128
# RENDER_GID=992
# VIDEO_GID=44

# Object storage (packages/storage): media, browser profiles, workspace
# checkpoints. STORAGE_DRIVER=s3 (default) is MinIO or any S3-compatible
# service, configured by the MINIO_* values below. STORAGE_DRIVER=gcs is
# Google Cloud Storage with Application Default Credentials (Workload
# Identity on GKE, `gcloud auth application-default login` on a laptop, a
# key file via GOOGLE_APPLICATION_CREDENTIALS elsewhere) — no MINIO_* needed;
# bucket names and the public origin then come from STORAGE_BUCKET,
# STORAGE_PROFILES_BUCKET, STUDIO_WORKSPACE_BUCKET and STORAGE_PUBLIC_URL
# (default https://storage.googleapis.com), with GCS_PROJECT for creation.
# Local development uses Google Cloud Storage through your Application Default
# Credentials (`gcloud auth application-default login`).
STORAGE_DRIVER="gcs"
GCS_PROJECT="your-gcp-project"
STORAGE_BUCKET="your-pitch-media"
STORAGE_PROFILES_BUCKET="your-pitch-profiles"
STUDIO_WORKSPACE_BUCKET="your-pitch-workspaces"
STORAGE_PUBLIC_URL="https://storage.googleapis.com"

#For lips sync of video/avatar 
SYNCLABS_API_KEY="yourSyncApiKeyHere"
CLOUDINARY_URL="cloudinaryUrlHere"

# Cloudflare Tunnel token (zero-trust public ingress via cloudflared).
# Consumed by the HOST systemd connector (cloudflared-pitch.service) via the
# repo .env — see docs/cloudflare-tunnel.md and scripts/cloudflared/install.sh.
# Create a tunnel at https://one.dash.cloudflare.com → Networks → Tunnels,
# then paste the token shown during setup here.
TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"

# Pitch Dev Tunnel (FRP + Caddy on trypitch.tech) - see docs/dev-tunnel.md
# Consumed by ./scripts/tunnel.sh to expose local ports on *.trypitch.tech
PITCH_TUNNEL_HOST="connect.trypitch.tech"
PITCH_TUNNEL_PORT="7000"
PITCH_TUNNEL_DOMAIN="trypitch.tech"
PITCH_TUNNEL_TOKEN="your_pitch_tunnel_token_here"

# Resend (for job-completion email notifications)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_..."
NEWSLETTER_FROM="Adnan from Pitch <noreply@trypitch.co>"
NEWSLETTER_PUBLIC_URL="https://api.trypitch.co"
NEWSLETTER_CTA_URL="https://trypitch.co"
NEWSLETTER_LOGO_URL="https://trypitch.co/tabLogoB.svg"
TRANSACTIONAL_EMAIL_FROM="Pitch <noreply@trypitch.co>"
EMAIL_REPLY_TO="support@trypitch.co"

# Dodo Payments
DODO_PAYMENTS_API_KEY="your_dodo_key"
DODO_PAYMENTS_WEBHOOK_SECRET="your_webhook_secret"
DODO_ENVIRONMENT="test_mode" # "live_mode" or "test_mode"

# Product ids for the current catalogue, created in the Dodo dashboard. Both
# sets are kept so flipping DODO_ENVIRONMENT can never sell a live product with
# a test key. A plan whose id is unset cannot be bought: checkout answers 503.
#   Flex        $20 one-time,  5,000 credits
#   Pro         $45 / month,   10,000 credits
#   Max         $80 / month,   30,000 credits
#   Pro Annual  $432 / year,   120,000 credits (20% off Pro monthly)
#   Max Annual  $768 / year,   360,000 credits (20% off Max monthly)
DODO_PRODUCT_FLEX_TEST="pdt_0NnNN4mih3dn5KjtQPDKT"
DODO_PRODUCT_PRO_TEST="pdt_0NnNNBrbyN8j2lj1cf3e3"
DODO_PRODUCT_MAX_TEST="pdt_0NnNNHEH5rfAZAX7Vx6bE"
DODO_PRODUCT_PRO_ANNUAL_TEST="pdt_0NnNNNANriBJb98wUn23Q"
DODO_PRODUCT_MAX_ANNUAL_TEST="pdt_0NnNNTOKfd9tXEp6qsfw0"
DODO_PRODUCT_FLEX_LIVE="pdt_0NnNJ59dgxP5xRQ9aiADY"
DODO_PRODUCT_PRO_LIVE="pdt_0NnNLFdXUuRxEAfUS0A2F"
DODO_PRODUCT_MAX_LIVE="pdt_0NnNLxEFUpjzHePJ1qNHc"
DODO_PRODUCT_PRO_ANNUAL_LIVE="pdt_0NnNM6BQDUQXKgVw0u7QS"
DODO_PRODUCT_MAX_ANNUAL_LIVE="pdt_0NnNMEHDGq7LlRvRmm16P"

# Affiliate Program
# A random secret string used to hash raw IPs for privacy compliance (GDPR / PDPB)
IP_SALT="change_this_to_a_random_secret_string"

# --- Discord Notifications (Optional) ---
# Notifications for signups, signins, job creations, and failures
# Create a webhook in Discord: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL="your_discord_webhook_url_here"

# Discord /video bot. Generate one long random value and use the same
# DISCORD_SERVICE_TOKEN for the API and bot containers.
DISCORD_BOT_TOKEN="your_discord_bot_token"
DISCORD_APPLICATION_ID="your_discord_application_id"
# Required: community server ID, used by the API to verify reward membership.
# The bot token must belong to a bot installed in this server.
DISCORD_GUILD_ID=""
DISCORD_SERVICE_TOKEN="replace_with_a_long_random_service_secret"
# Joining earns a one-time 120-credit grant into the regular Pitch balance.
# Required agent model for /video, which spends regular Pitch credits.
DISCORD_STUDIO_MODEL="google/gemini-3.8-flash"

# Vercel Production Environment Variables
# VITE_API_URL="https://api.trypitch.co"
# The API image contains CloakBrowser and launches it directly. Set a license
# key in production when concurrency exceeds the free binary's limit.
# CLOAKBROWSER_LICENSE_KEY=
# CLOAKBROWSER_VERSION=
