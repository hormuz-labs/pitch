# Database connection string (Local Postgres via Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5433/pitch?schema=public"

# Clerk Auth Keys (Required for User & Tenant Management)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
# Optional browser-side GIPHY Search key for storyboard GIF overlays.
# GIPHY requires Search API calls to originate from the client.
VITE_GIPHY_API_KEY="your_giphy_web_api_key_here"

# PostHog browser analytics (project key is safe to expose to the web client).
# Use https://eu.i.posthog.com instead when the PostHog project is in the EU region.
VITE_POSTHOG_KEY="phx_your_posthog_project_key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
CLERK_WEBHOOK_SIGNING_SECRET="whsec_your_clerk_webhook_signing_secret"

# Gemini API Keys (Required for Auto-Demo Generator Skill)
# Get your key from Google AI Studio
GEMINI_API_KEY="your_gemini_api_key_here"
# Alias required by the Vercel AI SDK's Google provider
GOOGLE_GENERATIVE_AI_API_KEY="your_gemini_api_key_here"

# ElevenLabs: generated music beds and sound effects (`pitch motion music|sound`), and
# narration when .pi/audio.json says tts.provider = "elevenlabs". Music needs a paid plan.
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
# ELEVENLABS_MUSIC_TIMEOUT_MS=600000
# ELEVENLABS_SFX_TIMEOUT_MS=120000
# ELEVENLABS_TTS_TIMEOUT_MS=180000

# API Port
PORT=3000

# Public app URL (used by Dodo to build success/cancel redirect URLs)
# In production set to: https://trypitch.co
APP_URL="http://localhost:5173"

# Studio (apps/api): every project is a pi agent session; launch/deck run sandboxed in Gondolin
# Where project workspaces live (default <repo>/projects)
# PROJECTS_DIR=/app/projects
# Model the studio agent runs on; pi reads GEMINI_API_KEY for the google provider.
STUDIO_MODEL="google/gemini-3.8-flash"
# Allowlist for the composer, comma-separated `provider/id` specs in menu order.
# Default: Gemini 3.8 Flash, Gemini 3.1 Pro, Gemma 4 31B, Gemma 4 26B,
# GPT-5.4 mini and GPT-5.4. Only Google and direct OpenAI providers are supported.
# GPT is disabled per user by default. Enable it in Admin > Users > GPT access.
# A provider key alone never grants GPT access.
# OPENAI_API_KEY="sk-..."

# Generated footage (video_generate). Uses the same GEMINI_API_KEY.
# OMNI_MODEL="gemini-omni-1.1-flash"
# OMNI_TIMEOUT_MS=900000
STUDIO_THINKING="high"
# Node binary for the launch-video scripts when the API runs under Bun (default: `node` on PATH)
# STUDIO_NODE=/usr/bin/node
# Host Python with requirements-audio.txt installed (default python3; Docker sets this).
# STUDIO_PYTHON=/absolute/path/to/pitch-audio/bin/python
# Where pi keeps session files (default ~/.pi/agent). Persist it in production.
# PI_AGENT_DIR=/root/.pi/agent
# Sandbox VM sizing / idle shutdown
# GONDOLIN_MEMORY=1G
# GONDOLIN_CPUS=2
# GONDOLIN_IDLE_MS=600000
# Signs the preview-iframe grant cookie (defaults to CLERK_SECRET_KEY)
# PREVIEW_COOKIE_SECRET=
# Origin the API uses to load its own previews for thumbnails (default http://127.0.0.1:$PORT)
# STUDIO_INTERNAL_ORIGIN=
# whisper.cpp for narration alignment (motion_align): whisper-cli on PATH + a ggml model
# WHISPER_CLI=whisper-cli
# WHISPER_MODEL=/root/.cache/whisper-cpp/ggml-base.en.bin
# WHISPER_THREADS=12
# Video encoding is selected automatically: VideoToolbox on native macOS;
# NVENC, then VAAPI, on Linux; libx264 otherwise. Override only for diagnostics.
# FFMPEG_ENCODER=auto
# Linux VAAPI render node. Find its group with: stat -c '%g' /dev/dri/renderD128
# FFMPEG_VAAPI_DEVICE=/dev/dri/renderD128
# RENDER_GID=992
# VIDEO_GID=44

# MinIO / S3-compatible storage (used by worker via packages/storage)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_ENDPOINT="http://localhost:9002"
MINIO_BUCKET="pitch-videos"
# The public base URL MinIO uses to serve files (set this to your server's public address)
# In production, point this to the Cloudflare-tunneled S3 API (e.g. https://s3.yourdomain.co)
MINIO_PUBLIC_URL="http://localhost:9002"

#For lips sync of video/avatar 
SYNCLABS_API_KEY="yourSyncApiKeyHere"
CLOUDINARY_URL="cloudinaryUrlHere"

# Cloudflare Tunnel token (zero-trust public ingress via cloudflared).
# Consumed by the HOST systemd connector (cloudflared-pitch.service) via the
# repo .env — see docs/cloudflare-tunnel.md and scripts/cloudflared/install.sh.
# Create a tunnel at https://one.dash.cloudflare.com → Networks → Tunnels,
# then paste the token shown during setup here.
TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"

# Pitch Dev Tunnel (FRP + Caddy on trypitch.tech) - see docs/dev-tunnel.md
# Consumed by ./scripts/tunnel.sh to expose local ports on *.trypitch.tech
PITCH_TUNNEL_HOST="connect.trypitch.tech"
PITCH_TUNNEL_PORT="7000"
PITCH_TUNNEL_DOMAIN="trypitch.tech"
PITCH_TUNNEL_TOKEN="your_pitch_tunnel_token_here"

# Resend (for job-completion email notifications)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_..."
NEWSLETTER_FROM="Adnan from Pitch <noreply@trypitch.co>"
NEWSLETTER_PUBLIC_URL="https://api.trypitch.co"
NEWSLETTER_CTA_URL="https://trypitch.co"
NEWSLETTER_LOGO_URL="https://trypitch.co/tabLogoB.svg"
TRANSACTIONAL_EMAIL_FROM="Pitch <noreply@trypitch.co>"
EMAIL_REPLY_TO="support@trypitch.co"

# Dodo Payments
DODO_PAYMENTS_API_KEY="your_dodo_key"
DODO_PAYMENTS_WEBHOOK_SECRET="your_webhook_secret"
DODO_ENVIRONMENT="test_mode" # "live_mode" or "test_mode"

# Product ids for the current catalogue, created in the Dodo dashboard. Both
# sets are kept so flipping DODO_ENVIRONMENT can never sell a live product with
# a test key. A plan whose id is unset cannot be bought: checkout answers 503.
#   Flex        $20 one-time,  800 credits
#   Pro         $45 / month,   2,500 credits
#   Max         $80 / month,   5,000 credits
#   Pro Annual  $432 / year,   30,000 credits (20% off Pro monthly)
#   Max Annual  $768 / year,   60,000 credits (20% off Max monthly)
DODO_PRODUCT_FLEX_TEST="pdt_0NnNN4mih3dn5KjtQPDKT"
DODO_PRODUCT_PRO_TEST="pdt_0NnNNBrbyN8j2Ij1cf3e3"
DODO_PRODUCT_MAX_TEST="pdt_0NnNNHEH5rfAZAX7Vx6bE"
DODO_PRODUCT_PRO_ANNUAL_TEST="pdt_0NnNNANriBJb98wUn23Q"
DODO_PRODUCT_MAX_ANNUAL_TEST="pdt_0NnNNTOKfd9tXEp6qsfw0"
DODO_PRODUCT_FLEX_LIVE="pdt_0NnNJ59dgxP5xRQ9aiADY"
DODO_PRODUCT_PRO_LIVE="pdt_0NnNLFdXUuRxEAfUS0A2F"
DODO_PRODUCT_MAX_LIVE="pdt_0NnNLxEFUpjzHePJ1qNHc"
DODO_PRODUCT_PRO_ANNUAL_LIVE="pdt_0NnNM6BQDUQXKgVw0u7QS"
DODO_PRODUCT_MAX_ANNUAL_LIVE="pdt_0NnNMEHDGq7LlRvRmm16P"

# Affiliate Program
# A random secret string used to hash raw IPs for privacy compliance (GDPR / PDPB)
IP_SALT="change_this_to_a_random_secret_string"

# --- Discord Notifications (Optional) ---
# Notifications for signups, signins, job creations, and failures
# Create a webhook in Discord: Server Settings → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL="your_discord_webhook_url_here"

# Discord /video bot. Generate one long random value and use the same
# DISCORD_SERVICE_TOKEN for the API and bot containers.
DISCORD_BOT_TOKEN="your_discord_bot_token"
DISCORD_APPLICATION_ID="your_discord_application_id"
# Optional: register instantly in one development server; omit for global registration.
DISCORD_GUILD_ID=""
DISCORD_SERVICE_TOKEN="replace_with_a_long_random_service_secret"
DISCORD_DAILY_VIDEO_LIMIT="3"
DISCORD_FREE_VIDEO_CREDITS="120"
# Required, explicit agent model for sponsored Discord generations.
DISCORD_STUDIO_MODEL="google/gemini-3.8-flash"

# Vercel Production Environment Variables
# VITE_API_URL="https://api.trypitch.co"
# NOTE: the browser reaches the CloakBrowser Manager only through the API's VNC
# proxy (/browser/profiles/:id/vnc), so no VITE_MANAGER_* var is needed on the
# web app. The API talks to the manager via CLOAK_MANAGER_URL below.


# --- CloakBrowser Manager ---
# The URL of your CloakBrowser Manager instance.
# Use http://localhost:8080 when running the worker/api directly on the host.
# When running via docker-compose.yml, the worker and api containers override
# this to http://cloakbrowser-manager:8080 automatically and the manager runs
# without auth inside the private Docker network.
CLOAK_MANAGER_URL="http://localhost:8080"
# Optional: shared secret for authenticating with the manager. Only needed if
# you run the manager exposed to the public internet. Not used in the default
# docker-compose setup where the manager is private.
CLOAK_MANAGER_AUTH_TOKEN=""

# The CloakBrowser profile the studio's motion_* tools drive over CDP. There is
# no Chromium in the image: recon, harvesting, motion_check, the audit and the
# renderer all connect to the manager above and are served the workspace over
# request interception. Leave unset unless you want a dedicated profile per
# environment; STUDIO_CDP_URL overrides the manager entirely with one endpoint.
STUDIO_CDP_PROFILE="studio-motion"
# STUDIO_CDP_URL=""
