# Database connection string (Local Postgres via Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5433/pitch?schema=public"

# Clerk Auth Keys (Required for User & Tenant Management)
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Gemini API Keys (Required for Auto-Demo Generator Skill)
# Get your key from Google AI Studio
GEMINI_API_KEY="your_gemini_api_key_here"

# Redis connection for BullMQ (Worker & API)
REDIS_URL="redis://localhost:6379"

# API Port
PORT=3000

# Public app URL (used by Stripe to build success/cancel redirect URLs)
# In production set to: https://trypitch.co
APP_URL="http://localhost:5173"

# OpenCode Server (Webhook target for the Worker)
OPENCODE_SERVER_URL="http://localhost:8080/generate"

# MinIO / S3-compatible storage (used by job-cli via packages/storage)
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
MINIO_ENDPOINT="http://localhost:9002"
MINIO_BUCKET="pitch-videos"
# The public base URL MinIO uses to serve files (set this to your server's public address)
# In production, point this to the Cloudflare-tunneled S3 API (e.g. https://s3.yourdomain.co)
MINIO_PUBLIC_URL="http://localhost:9002"

#For lips sync of video/avatar 
SYNCLABS_API_KEY="yourSyncApiKeyHere"
CLOUDINARY_URL="cloudinaryUrlHere"

# Cloudflare Tunnel token (for zero-trust public ingress via cloudflared)
# Create a tunnel at https://one.dash.cloudflare.com → Networks → Tunnels
# then paste the token shown during setup here.
TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"

# Gmail SMTP (for job-completion email notifications)
# Use a Gmail App Password — NOT your real Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="your_16_char_app_password"

# Stripe (for Checkout and affiliate conversion webhooks)
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
# Webhook secret from https://dashboard.stripe.com/webhooks → add endpoint /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Affiliate Program
# A random secret string used to hash raw IPs for privacy compliance (GDPR / PDPB)
IP_SALT="change_this_to_a_random_secret_string"

# --- Telegram Notifications (Optional) ---
# Notifications for signups, signins, job creations, and failures
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"
