# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
**/dist/
*.tsbuildinfo

# Test / coverage
coverage/

# Local env files — never bake secrets into the image
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OpenCode logs (bind-mounted from worker container)
opencode-logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Git
.git/
.gitignore

# Docker
.dockerignore

# Monorepo tooling
.pnpm-store/

# App-specific generated / transient files
apps/web/public/videos/
apps/web/dist/
demos/
*.webm
*.mp4
!assets/backgrounds/*.mp4
!apps/web/public/backgrounds/*.mp4

# Local dev data directories (large, not needed in images)
# Keep every spelling explicit. Some BuildKit context senders attempt to walk
# an unreadable bind-mount directory before applying a trailing-slash pattern.
/docker-data
/docker-data/**
docker-data
docker-data/**
.playwright-cli/
recordings/
grafana/

# Local tooling artifacts
output.html
outreach-plan.md
skills-lock.json
timestamps.json
