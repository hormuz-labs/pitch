.env
.env.*
!.env.example
.github_token
.gh_token
.secrets/
**/*.pem
**/*.key
gha-creds-*.json

# Logs
*.log
npm-debug.log*

# OpenCode logs (bind-mounted from worker container)
opencode-logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Git
.git/
.git
.gitignore

# Docker
.dockerignore

# Monorepo tooling
.pnpm-store/

# App-specific generated / transient files
apps/web/public/videos/
apps/web/dist/
demos/
*.webm
*.mp4
!assets/backgrounds/*.mp4
!apps/web/public/backgrounds/*.mp4

# Local dev data directories (large, not needed in images)
docker-data/
projects/
renders/
.playwright-cli/
recordings/
grafana/

