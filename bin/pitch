#!/usr/bin/env bun
/**
 * `pitch` on a developer's terminal — the same command line the agent runs.
 *
 * The agent reaches these commands through the `pitch` tool
 * (.pi/extensions/pitch-cli.ts); this is the same dispatcher with argv instead
 * of a string, so anything you can debug here is exactly what the agent gets.
 *
 *   bin/pitch help
 *   bin/pitch effects search a card flipping to reveal a price
 *   bin/pitch motion check --page index.html
 *
 * Commands run against the current directory as the project workspace, which
 * is what the studio does with a project folder.
 */
import { run } from '../.pi/cli/run.ts'

const argv = process.argv.slice(2)
const command = argv
  .map(a => (/[\s"']/.test(a) ? JSON.stringify(a) : a))
  .join(' ')

try {
  console.log(await run(command, { cwd: process.cwd() }))
} catch (err) {
  console.error(`pitch: ${err instanceof Error ? err.message : String(err)}`)
  process.exit(1)
}
