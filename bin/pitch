#!/usr/bin/env bun
/**
 * `pitch` on a developer's terminal — the same command line the agent runs.
 *
 * In the studio the agent's shell has a `pitch` too (.pi/guest/pitch), a
 * client for a socket that ends in the same dispatcher this calls directly.
 * So anything you can debug here is exactly what the agent gets.
 *
 *   bin/pitch --help
 *   bin/pitch icons search slack messaging
 *   bin/pitch motion check --page index.html
 *
 * Commands run against the current directory as the project workspace, which
 * is what the studio does with a project folder.
 */
import { run } from '../.pi/cli/run.ts'

const { text, ok } = await run(process.argv.slice(2), { cwd: process.cwd() })
console.log(text)
process.exit(ok ? 0 : 1)
