# syntax=docker/dockerfile:1
FROM oven/bun:1-debian

# Install runtime dependencies for browser automation, media processing, and opencode
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl unzip ffmpeg ca-certificates \
    mesa-vulkan-drivers libgl1-mesa-dri libglx-mesa0 libegl1 mesa-va-drivers \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://opencode.ai/install | bash

# Install agent-browser globally and run its install command
RUN bun install -g agent-browser && agent-browser install

# Trigger CI rebuild
ENV PATH="/root/.opencode/bin:${PATH}"

