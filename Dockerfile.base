# syntax=docker/dockerfile:1
FROM oven/bun:1-debian

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Single RUN layer with BuildKit cache mounts to avoid re-downloading packages
# across rebuilds. Merged from 4 layers → 1 to eliminate redundant `apt-get update`
# and keep the final image lean.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    --mount=type=cache,target=/root/.npm \
    apt-get -qq update \
    && apt-get install -y -qq --no-install-recommends \
        curl unzip ca-certificates xz-utils \
        mesa-vulkan-drivers libgl1-mesa-dri libglx-mesa0 libegl1 mesa-va-drivers \
        libxcb-shm0 libx11-xcb1 libx11-6 libxcb1 libxext6 libxrandr2 libxcomposite1 libxcursor1 libxdamage1 libxfixes3 libxi6 \
        libgtk-3-0 libpangocairo-1.0-0 libpango-1.0-0 libatk1.0-0 libcairo-gobject2 libcairo2 libgdk-pixbuf-2.0-0 libxrender1 \
        libasound2t64 libfreetype6 libfontconfig1 libdbus-1-3 libnss3 libnspr4 libatk-bridge2.0-0 libdrm2 libxkbcommon0 \
        libatspi2.0-0 libcups2 libxshmfence1 libgbm1 fonts-noto-color-emoji fonts-noto-cjk fonts-freefont-ttf ffmpeg \
        poppler-utils \
        tesseract-ocr \
        bubblewrap \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    # Node 22 (the launch-video skill scripts and the Gondolin sandbox
    # need a current Node; Debian's package is too old).
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y -qq --no-install-recommends nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && npm install -g playwright @playwright/cli@latest --quiet \
    && playwright install ffmpeg

# whisper.cpp for narration alignment (motion_align). The model is NOT baked in:
# mount ./docker-data/whisper at /root/.cache/whisper-cpp and drop a ggml model
# there (e.g. ggml-large-v3-turbo.bin, see .env.example WHISPER_MODEL).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get -qq update \
    && apt-get install -y -qq --no-install-recommends git cmake build-essential \
    && git clone --depth 1 https://github.com/ggml-org/whisper.cpp /tmp/whisper.cpp \
    && cmake -S /tmp/whisper.cpp -B /tmp/whisper.cpp/build -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF \
    && cmake --build /tmp/whisper.cpp/build -j"$(nproc)" --target whisper-cli \
    && install -m 755 /tmp/whisper.cpp/build/bin/whisper-cli /usr/local/bin/whisper-cli \
    && (cp /tmp/whisper.cpp/build/src/libwhisper.so* /tmp/whisper.cpp/build/ggml/src/libggml*.so* /usr/local/lib/ 2>/dev/null || true) \
    && ldconfig \
    && rm -rf /tmp/whisper.cpp \
    && apt-get purge -y -qq git cmake build-essential && apt-get autoremove -y -qq \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

