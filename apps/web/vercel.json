{
  "rewrites": [
    {
      "source": "/r/(.*)",
      "destination": "https://api.trypitch.co/r/$1"
    },
    {
      "source": "/d/(.*)",
      "destination": "https://api.trypitch.co/d/$1"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
