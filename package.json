{
  "name": "silverfish",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bun run db:up && echo 'Waiting for databases to start...' && sleep 3 && bun run db:migrate",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "./node_modules/.bin/dotenv -o -e .env -- packages/db/node_modules/.bin/prisma migrate dev --schema=packages/db/prisma/schema.prisma --name init",
    "db:sync": "./scripts/db-sync.sh",
    "db:studio": "./node_modules/.bin/dotenv -o -e .env -- bunx @zenstackhq/proxy --schema=packages/db/prisma/schema.zmodel",
    "postinstall": "./scripts/zenstack-generate.sh && bun --filter @saas/db build || (test -n \"$VERCEL\" && echo 'Postinstall failed on Vercel, but continuing as only web is required')",
    "build": "bun --filter '*' build",
    "dev": "bun --filter '*' dev",
    "start": "bun --filter '*' start",
    "job-cli": "bun apps/job-cli/src/index.ts",
    "credits": "bun apps/job-cli/src/index.ts credits",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@zenstackhq/runtime": "^2.22.1",
    "axios": "^1.15.2",
    "bullmq": "^5.76.3",
    "bun-types": "^1.3.13",
    "dotenv-cli": "^11.0.0",
    "ioredis": "^5.10.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5",
    "zenstack": "^2.22.1"
  },
  "dependencies": {
    "@google/genai": "",
    "dotenv": "",
    "fluent-ffmpeg": "",
    "mime": "",
    "playwright": "^1.59.1",
    "puppeteer": ""
  }
}
