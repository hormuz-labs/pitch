{
  "name": "video-gen-saas",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun --filter @saas/db run build || bunx prisma generate --schema=packages/db/prisma/schema.prisma",
    "build": "bun --filter '*' build",
    "dev": "bun --filter '*' dev",
    "start": "bun --filter '*' start",
    "job-cli": "bun apps/job-cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "axios": "^1.15.2",
    "bullmq": "^5.76.3",
    "bun-types": "^1.3.13",
    "ioredis": "^5.10.1",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
