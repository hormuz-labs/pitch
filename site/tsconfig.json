{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@solidjs/router": [
        "./src/shims/router.tsx"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src"
  ],
  "exclude": [
    "dist"
  ]
}
